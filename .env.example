# Copy to .env and fill in. .env is gitignored and must never be committed.
# In deployed environments these come from AWS Secrets Manager, not from this file.

# --- Supabase (project region: ap-south-1 / Mumbai) ---
# Direct host db.<ref>.supabase.co is IPv6-only since Supabase retired IPv4 — use the pooler.
SUPABASE_URL=https://fytmkmifcwdbsbmhprgl.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.fytmkmifcwdbsbmhprgl:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Moodle ---
# Canonical host includes `www` — the bare host 301-redirects and will break the OAuth2 callback.
MOODLE_URL=https://www.learn.hilomcollective.com
MOODLE_WS_TOKEN=

# --- PayMongo (TEST mode for all pre-launch work) ---
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- AWS ---
AWS_REGION=ap-southeast-1
